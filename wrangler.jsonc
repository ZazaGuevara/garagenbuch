// Cloudflare-Einstellungen: App (Ordner public/) + kleine Server-Funktion (worker/) für die Google-Anmeldung.
// Geheimnisse GOOGLE_CLIENT_ID und GOOGLE_CLIENT_SECRET sind im Cloudflare-Dashboard hinterlegt (nicht hier).
{
  "name": "garagenbuch",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Kleiner Speicher für die Google-Verbindung (wird beim ersten Deploy automatisch angelegt)
  "kv_namespaces": [
    { "binding": "GB" }
  ]
}
